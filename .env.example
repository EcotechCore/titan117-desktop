# Copy to .env (git-ignored). Read only when the app runs from source; a
# packaged app never reads it.

# A development OpenRouter key, for cloud models while there are no accounts
# or credits yet. Make one at https://openrouter.ai/keys with a low limit.
OPENROUTER_API_KEY=

# Signing in (decisions §39): the development web app and the Convex
# deployment's HTTP actions (its .convex.site address). With both set, the app
# locks until you sign in, and cloud calls use your credits through the proxy.
# Leave them empty to work without an account (from source only).
TITAN117_WEB_URL=http://localhost:3100
TITAN117_API_URL=
